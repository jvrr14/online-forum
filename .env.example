# PostgreSQL connection string
#
# Local Docker (run: docker compose up -d)
DATABASE_URL=postgresql://forum_user:forum_pass@localhost:5432/forum_db
#
# Neon cloud (https://console.neon.tech → Connection string)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT signing secrets — use distinct values, each at least 32 characters
# Generate each independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-random-refresh-secret-at-least-32-chars

# Optional for db:seed: supply an already-hashed password (1–100 characters).
# Without it, the sample user's password login is disabled.
# SEED_USER_PASSWORD_HASH=

# Server port (defaults to 3000 if omitted)
PORT=3000

# Runtime environment
NODE_ENV=development

# Structured log verbosity
LOG_LEVEL=info

# Service label included in every log record
SERVICE_NAME=online-forum-api

# Maximum time allowed for graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Expired-session cleanup interval (milliseconds; defaults to one hour)
SESSION_CLEANUP_INTERVAL_MS=3600000
